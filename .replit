# Replit configuration
# This .replit file attempts to auto-detect and run the project.
# It runs Node if package.json exists, otherwise tries Flutter if pubspec.yaml exists.
run = "bash -lc 'if [ -f package.json ]; then npm install && npm run start; elif [ -f pubspec.yaml ]; then flutter pub get && flutter run; else echo \"No runnable project found. Please edit .replit to set the run command.\"; fi'"
